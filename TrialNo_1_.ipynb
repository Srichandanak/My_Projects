      "source": [
        "# Initialize Gemini as the LLM\n",
        "llm = ChatGoogleGenerativeAI(model=\"gemini-1.5-flash\")\n",
        "\n",
        "# Add memory so chatbot remembers previous questions\n",
        "memory = ConversationBufferMemory()\n",
        "\n",
        "# Create a conversation chain\n",
        "conversation = ConversationChain(\n",
        "    llm=llm,\n",
        "    memory=memory,\n",
        "    verbose=True  # Shows debug info; LangSmith will also log traces\n",
        ")\n",
        "\n",
        "def generate_answer(caption: str, question: str) -> str:\n",
        "    \"\"\"\n",
        "    Answer a question about an image based on its caption.\n",
        "    \"\"\"\n",
        "    prompt = f\"The image caption is: '{caption}'. Answer the question: {question}\"\n",
        "    answer = conversation.predict(input=prompt)\n",
        "    return answer.strip()\n"
      ],
