    {
      "cell_type": "code",
      "source": [
        "caption_model_name = \"Salesforce/blip2-flan-t5-xl\"\n",
        "caption_processor = BlipProcessor.from_pretrained(caption_model_name)\n",
        "caption_model = Blip2ForConditionalGeneration.from_pretrained(\n",
        "    caption_model_name,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map=\"auto\"\n",
        ")\n",
        "\n",
        "def generate_caption(image_path: str) -> str:\n",
        "    \"\"\"\n",
        "    Generate a caption for an image using BLIP-2.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        image = Image.open(image_path).convert(\"RGB\")\n",
        "        inputs = caption_processor(images=image, return_tensors=\"pt\").to(caption_model.device, torch.float16)\n",
        "        output = caption_model.generate(**inputs, max_new_tokens=50)\n",
        "        caption = caption_processor.decode(output[0], skip_special_tokens=True)\n",
        "        return caption.strip()\n",
        "    except Exception as e:\n",
        "        print(f\"[Error] Caption generation failed: {e}\")\n",
        "        return \"Could not generate caption.\"\n"
      ],
