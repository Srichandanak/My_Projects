        "from google.colab import files\n",
        "\n",
        "# Upload an image\n",
        "uploaded = files.upload()\n",
        "image_path = next(iter(uploaded))\n",
        "\n",
        "# Ask a question\n",
        "response = chatbot_backend(image_path, \"What is happening in this picture?\")\n",
        "print(\"Caption:\", response[\"caption\"])\n",
        "print(\"Answer:\", response[\"answer\"])\n",
        "\n",
        "# Ask another question to test conversation memory\n",
        "follow_up = chatbot_backend(image_path, \"What might happen next?\")\n",
        "print(\"Follow-up Answer:\", follow_up[\"answer\"])\n"
