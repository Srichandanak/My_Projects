        "def chatbot_backend(image_path: str, user_question: str) -> dict:\n",
        "    \"\"\"\n",
        "    Complete pipeline: Image -> Caption -> Q&A with memory\n",
        "    \"\"\"\n",
        "    caption = generate_caption(image_path)\n",
        "    answer = generate_answer(caption, user_question)\n",
        "    return {\"caption\": caption, \"answer\": answer}\n"
      ],
      "metadata": {
        "id": "NeOB9wJZEgBX"
      },
      "execution_count": null,
      "outputs": []
