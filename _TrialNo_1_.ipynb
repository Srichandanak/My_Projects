caption_model_name = "Salesforce/blip2-flan-t5-xl"
caption_processor = BlipProcessor.from_pretrained(caption_model_name)
caption_model = Blip2ForConditionalGeneration.from_pretrained(
    caption_model_name,
    torch_dtype=torch.float16,
    device_map="auto"
)

def generate_caption(image_path: str) -> str:
    """
    Generate a caption for an image using BLIP-2.
    """
    try:
        image = Image.open(image_path).convert("RGB")
        inputs = caption_processor(images=image, return_tensors="pt").to(caption_model.device, torch.float16)
        output = caption_model.generate(**inputs, max_new_tokens=50)
        caption = caption_processor.decode(output[0], skip_special_tokens=True)
        return caption.strip()
    except Exception as e:
        print(f"[Error] Caption generation failed: {e}")
        return "Could not generate caption."


# Initialize Gemini as the LLM
llm = ChatGoogleGenerativeAI(model="gemini-1.5-flash")

# Add memory so chatbot remembers previous questions
memory = ConversationBufferMemory()

# Create a conversation chain
conversation = ConversationChain(
    llm=llm,
    memory=memory,
    verbose=True  # Shows debug info; LangSmith will also log traces
)

def generate_answer(caption: str, question: str) -> str:
    """
    Answer a question about an image based on its caption.
    """
    prompt = f"The image caption is: '{caption}'. Answer the question: {question}"
    answer = conversation.predict(input=prompt)
    return answer.strip()


def chatbot_backend(image_path: str, user_question: str) -> dict:
    """
    Complete pipeline: Image -> Caption -> Q&A with memory
    """
    caption = generate_caption(image_path)
    answer = generate_answer(caption, user_question)
    return {"caption": caption, "answer": answer}


from google.colab import files

# Upload an image
uploaded = files.upload()
image_path = next(iter(uploaded))

# Ask a question
response = chatbot_backend(image_path, "What is happening in this picture?")
print("Caption:", response["caption"])
print("Answer:", response["answer"])

# Ask another question to test conversation memory
follow_up = chatbot_backend(image_path, "What might happen next?")
print("Follow-up Answer:", follow_up["answer"])


